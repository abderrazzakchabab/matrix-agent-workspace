# ── Control Plane ─────────────────────────────────────────────
# Next.js / Vercel deployment
CONTROL_PLANE_URL=http://localhost:3000

# ── PostgreSQL ────────────────────────────────────────────────
DATABASE_URL=postgresql://matrix:matrix_test_password@localhost:5432/matrix_test

# ── Synapse (Matrix homeserver) ───────────────────────────────
SYNAPSE_BASE_URL=http://localhost:8008
SYNAPSE_SERVER_NAME=example.test

# ── Encryption ────────────────────────────────────────────────
# AES-256-GCM envelope key (32 bytes, hex-encoded)
ENVELOPE_KEY_VERSION=1
ENVELOPE_KEY_HEX=

# ── GitHub ────────────────────────────────────────────────────
# Phase B read-only GitHub App
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ── Inngest ───────────────────────────────────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── AI Gateway / Provider ─────────────────────────────────────
AI_GATEWAY_URL=
AI_GATEWAY_API_KEY=

# ── Testing ───────────────────────────────────────────────────
TEST_SYNAPSE_ADMIN_TOKEN=
