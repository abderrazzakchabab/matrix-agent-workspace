# ── Control Plane ─────────────────────────────────────────────
# Next.js / Vercel deployment
CONTROL_PLANE_URL=http://localhost:3000

# ── PostgreSQL ────────────────────────────────────────────────
# Application role (subject to row-level security).
DATABASE_URL=postgresql://matrix_app:matrix_app_password@localhost:5432/matrix_test
# Owner role used only for applying migrations and running fixtures.
MIGRATIONS_DATABASE_URL=postgresql://matrix:matrix_test_password@localhost:5432/matrix_test

# ── Synapse (Matrix homeserver) ───────────────────────────────
SYNAPSE_BASE_URL=http://localhost:8008
SYNAPSE_SERVER_NAME=example.test

# ── Encryption ────────────────────────────────────────────────
# AES-256-GCM envelope keys. ENVELOPE_KEY_HEX is a comma-separated list of
# `version:hex` entries (each key 32 bytes hex-encoded); a bare hex value uses
# ENVELOPE_KEY_VERSION as its version. ENVELOPE_KEY_VERSION selects the active
# key (defaults to the last key when unset).
ENVELOPE_KEY_VERSION=1
ENVELOPE_KEY_HEX=

# ── GitHub ────────────────────────────────────────────────────
# Phase B read-only GitHub App
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ── Inngest ───────────────────────────────────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── AI Gateway / Provider ─────────────────────────────────────
# Optional; defaults to the Cloudflare AI Gateway local development endpoint.
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=

# ── Testing ───────────────────────────────────────────────────
TEST_SYNAPSE_ADMIN_TOKEN=
